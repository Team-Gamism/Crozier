  m_Script: {fileID: 11500000, guid: 30f37a2e062517044aa8bbf7b10ecbed, type: 3}
  m_Name: Problem1-1
  m_EditorClassIdentifier: 
  dialogDataList:
  - textData: "\uC8FC\uAD50\uB2D8\uC758 \uD310\uACB0\uC744 \uC804\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uD53C\uACE0 \uC54C\uBE44\uB204\uC2A4\uB294 \uC6D0\uACE0\uC5D0\uAC8C
      500\uB370\uB098\uB85C\uC758 \uCC44\uBB34 \uC804\uC561\uC744 \uC0C1\uD658\uD558\uACE0,"
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uC790\uC2E0\uC774 \uD638\uCD9C\uD55C \uC218\uB808\uC758 \uC6B4\uC1A1\uBE44
      \uB610\uD55C \uC2A4\uC2A4\uB85C \uBD80\uB2F4\uD574\uC57C \uD569\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uC9C0\uBCD1\uC740 \uB3D9\uC815\uC758 \uB300\uC0C1\uC774 \uB420 \uC218\uB294
      \uC788\uC73C\uB098, \uCC45\uC784\uC744 \uBA74\uD558\uAC8C \uD558\uC9C0\uB294
      \uBABB\uD569\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uAC10\uC0AC\uD569\uB2C8\uB2E4, \uC8FC\uAD50\uB2D8. \uC815\uC758\uB85C\uC6B4
      \uD310\uB2E8\uC785\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 36bc3fdf7b19b7340abbfa25d69ea4ed, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "(\uC501\uC4F8\uD558\uAC8C \uC6C3\uC73C\uBA70) \uC5ED\uC2DC \uB3C8
      \uC55E\uC5D0\uC11C \uC0AC\uC815 \uB530\uC708 \uC0AC\uCE58\uC600\uAD70\uC694\u2026"
    typingTime: 0.02
    speakerName: "\uC54C\uBE44\uB204\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 85dee7df9f8898c45b3280d307304b57, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uAC1A\uACA0\uC2B5\uB2C8\uB2E4. \uBC95\uC815\uC5D0\uC11C\uB4E0, \uB0B4
      \uC0B6\uC5D0\uC11C\uB4E0."
    typingTime: 0.02
    speakerName: "\uC54C\uBE44\uB204\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 0c1f15ceda3ffff43a118fa2c624dea7, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uACE0\uD1B5\uC740 \uC774\uD574\uBC1B\uC744 \uC218 \uC788\uC9C0\uB9CC,
      \uADF8\uB85C \uC778\uD574 \uCC45\uC784\uC774 \uAC00\uBCBC\uC6CC\uC9C0\uC9C0\uB294
      \uC54A\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
