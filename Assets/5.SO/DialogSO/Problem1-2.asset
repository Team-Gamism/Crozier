  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 30f37a2e062517044aa8bbf7b10ecbed, type: 3}
  m_Name: Problem1-2
  m_EditorClassIdentifier: 
  dialogDataList:
  - textData: "\uC8FC\uAD50\uB2D8\uC758 \uD310\uACB0\uC744 \uC804\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uD53C\uACE0 \uC54C\uBE44\uB204\uC2A4\uB294 500\uB370\uB098\uB85C\uC758
      \uCC44\uBB34\uB294 \uC804\uC561 \uC0C1\uD658\uD574\uC57C \uD569\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uADF8\uB7EC\uB098 \uC624\uB298 \uBC95\uC815\uC5D0 \uCD9C\uB450\uD558\uAE30
      \uC704\uD574 \uC774\uC6A9\uD55C \uC218\uB808\uB294 \uC815\uB2F9\uD55C \uD544\uC694\uC5D0
      \uC758\uD55C \uAC83\uC774\uC5C8\uC73C\uBA70,"
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uADF8 \uBE44\uC6A9\uC740 \uC6D0\uACE0 \uCE21\uC774 \uC7AC\uD310 \uC808\uCC28\uC0C1
      \uBD80\uB2F4\uD558\uB294 \uAC83\uC774 \uD0C0\uB2F9\uD569\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    isLastDialog: 0
    isNoRecord: 1
  - textData: "(\uAE30\uBD84\uC774 \uC0C1\uD55C \uB4EF) \u2026\uC6B4\uC1A1\uBE44\uAE4C\uC9C0
      \uB5A0\uC548\uC544\uC57C \uD55C\uB2E4\uACE0\uC694?"
    typingTime: 0.02
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uC774\uAC74 \uC880 \uC9C0\uB098\uCE5C \uCC98\uC0AC \uC544\uB2D9\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uADF8\uB798\uB3C4 \uC800\uB294 \uC81C \uBE5A\uC740 \uAC1A\uACA0\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uC54C\uBE44\uB204\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    isLastDialog: 0
    isNoRecord: 1
  - textData: "(\uBB18\uD55C \uC6C3\uC74C) \uC8FC\uAD50\uB2D8, \uAC10\uC0AC\uD569\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uC54C\uBE44\uB204\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uC9C4\uC2E4\uC740 \uD3B8\uD5A5\uB418\uC9C0 \uC54A\uC73C\uBA70, \uB3D9\uC815\uC740
      \uB54C\uB54C\uB85C \uBE44\uC6A9\uBCF4\uB2E4 \uBB34\uAC81\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uADF8 \uBE5A\uC744 \uAC1A\uB294 \uAC83\uC740 \uB3C8\uBFD0\uB9CC\uC774
      \uC544\uB2D9\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    isLastDialog: 1
    isNoRecord: 1
