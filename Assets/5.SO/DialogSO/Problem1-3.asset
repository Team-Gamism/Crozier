  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 30f37a2e062517044aa8bbf7b10ecbed, type: 3}
  m_Name: Problem1-3
  m_EditorClassIdentifier: 
  dialogDataList:
  - textData: "\uC8FC\uAD50\uB2D8\uC758 \uD310\uACB0\uC744 \uC804\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 2dcbf3b6082e9e5438c19528196845c9, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uD53C\uACE0 \uC54C\uBE44\uB204\uC2A4\uB294 \uBC18\uBCF5\uC801\uC778
      \uCC44\uBB34 \uBD88\uC774\uD589,"
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: de9b43ef929436542bf3d7fa1481f9d4, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uBC95\uC815\uBAA8\uB3C5\uC131 \uC5B8\uD589, \uD0C0\uC778\uC758 \uC2DC\uAC04\uACFC
      \uC790\uC6D0\uC744 \uC545\uC6A9\uD55C \uC810\uC744 \uACE0\uB824\uD558\uC5EC,"
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: e065dd66a8ad0d34d9737cffea641788, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uC0AC\uD615\uC5D0 \uCC98\uD569\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: ec7292e45e7edcc498ebea7583132119, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "(\uB180\uB780 \uB4EF) \uC544... \uC8FC\uAD50\uB2D8, \uC800\uB294\u2026
      \uAC70\uAE30\uAE4C\uC9C0\uB294 \uBC14\uB77C\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4\u2026"
    typingTime: 0.02
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: c073e533c2ab16b4588978c81099a162, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "(\uC4F4\uC6C3\uC74C) \uC774\uB807\uAC8C\uAE4C\uC9C0\u2026"
    typingTime: 0.02
    speakerName: "\uC54C\uBE44\uB204\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: aefec362c60d449439d9819584f612e3, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uACB0\uAD6D \uC774 \uBAB8\uB6B1\uC774 \uD558\uB098\uB85C \uBAA8\uB4E0
      \uAC78 \uAC1A\uAC8C \uB418\uB294\uAD70\uC694."
    typingTime: 0.02
    speakerName: "\uC54C\uBE44\uB204\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 669525906f3b22d45945b9133776549c, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uB54C\uB85C\uB294 \uC0AC\uB78C\uC774 \uC544\uB2C8\uB77C, \uBC95\uC774
      \uCE7C\uC744 \uC950\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 5333ab154a7639744a646345033abe72, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uC774 \uD310\uACB0\uC740 \uB2F9\uC2E0\uC774 \uC544\uB2CC, \uB2F9\uC2E0\uC774
      \uBB34\uC2DC\uD55C \uCC45\uC784\uC5D0\uAC8C \uB0B4\uB824\uC9C4 \uAC83\uC785\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: e1caedb945bd00f4ab732cb17e79e324, type: 3}
    isLastDialog: 1
    isNoRecord: 1
