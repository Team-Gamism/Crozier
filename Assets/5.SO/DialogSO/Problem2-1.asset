    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: d4640ee50fd3d6445b97b0280ebe4a9f, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uD53C\uACE0\uC5D0\uAC8C \uBD80\uAD8C \uC0C1\uC2E4\uC744 \uBA85\uD569\uB2C8\uB2E4."
