    isNoRecord: 1
  - textData: "\uD53C\uACE0\uB294 \uC790\uC2DD\uC744 \uC138 \uBC88\uC5D0 \uAC78\uCCD0
      \uD0C0\uC778\uC5D0\uAC8C \uB178\uC608 \uACC4\uC57D\uC73C\uB85C \uB118\uAE34
      \uAE30\uB85D\uC774 \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
