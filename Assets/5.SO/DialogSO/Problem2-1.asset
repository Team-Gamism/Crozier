    choiceList: []
    dialogSound: {fileID: 8300000, guid: 4f075d91694d7614280d6a07b3b75017, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "(\uC228\uC744 \uAE38\uAC8C \uB0B4\uC270\uB2E4) ...\uB4DC\uB514\uC5B4
      \uB05D\uC774\uAD70\uC694. "
    typingTime: 0.02
    speakerName: "\uB8E8\uD0A4\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 8bb6e584349af224bb32d3f0612fd6cb, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "(\uBC84\uB7ED \uC18C\uB9AC\uCE58\uBA70) \uAC70\uC9D3\uB9D0\uC774\uB2E4!
      \uB450 \uBC88\uC774\uC5C8\uB2E4! \uB124 \uC5B4\uBBF8\uAC00 \uB9D0\uB838\uC73C\uBA74
      \uC138 \uBC88\uC9F8\uB294 \uC5C6\uC5C8\uC744 \uAC70\uB2E4!"
