  m_Name: Problem2
  m_EditorClassIdentifier: 
  dialogDataList:
  - textData: "\uC7AC\uD310\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4!"
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uBCF8 \uC0AC\uAC74\uC740 \uC790\uC2DD \uB8E8\uD0A4\uC6B0\uC2A4\uAC00
      \uC544\uBC84\uC9C0 \uAC08\uB8E8\uC2A4\uB97C \uC0C1\uB300\uB85C \uBD80\uAD8C
      \uC0C1\uC2E4\uC744 \uC694\uAD6C\uD55C \uB0B4\uC6A9\uC785\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC790, \uC6D0\uACE0 \uB8E8\uD0A4\uC6B0\uC2A4, \uC9C4\uC220\uD558\uC2ED\uC2DC\uC624."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC8FC\uAD50\uB2D8\u2026 \uC804 \uC81C \uC544\uBC84\uC9C0\uB97C \uACE0\uBC1C\uD569\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uD0A4\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: f84bc981f5bff814bb5705483326c7e3, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uADF8\uB294 \uC800\uB97C \uC138 \uBC88\uC774\uB098 \uD314\uC558\uC2B5\uB2C8\uB2E4.
      \uB178\uC608\uCC98\uB7FC\uC694."
    typingTime: 0.02
    speakerName: "\uB8E8\uD0A4\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 01663b06880d3ea428a32fbf8609bc13, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uCC98\uC74C\uC5D4 \uBE5A \uB300\uC2E0 \uC800\uB97C \uB118\uACBC\uACE0,"
    typingTime: 0.02
    speakerName: "\uB8E8\uD0A4\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: e3be47ffe538a7c478ae3bfe867e0c87, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uB450 \uBC88\uC9F8\uB294 \uC18C\uC791\uC9C0\uC5D0\uC11C \uB178\uC5ED\uD558\uB3C4\uB85D
      \uACC4\uC57D\uC11C\uC5D0 \uC11C\uBA85\uD588\uC73C\uBA70,"
    typingTime: 0.02
    speakerName: "\uB8E8\uD0A4\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 71a56b7bbc7d2dc489b747f2ee6871e5, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC138 \uBC88\uC9F8\uB294 \uC800\uB97C \uD558\uC778\uC73C\uB85C \uB118\uAE30\uB294
      \uACC4\uC57D\uC11C\uB97C \uC9C1\uC811 \uC791\uC131\uD588\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uD0A4\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: e3df1ac6d99b8a44b8b09b72b8b11f40, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC774 \uBAA8\uB4E0 \uACC4\uC57D\uC740 \uAE30\uB85D\uAD00\uC2E4\uC5D0
      \uBCF4\uAD00\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uD0A4\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: da0bc719f90d7794db225354c9f3d3a8, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uADF8\uB7F0\uB370\uB3C4 \uADF8\uB294 \uC800\uB97C \uC790\uC2DD\uC774\uB77C
      \uBD80\uB974\uBA70, \uC81C \uC0B6\uC744 \uC870\uC885\uD558\uB824 \uD569\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uD0A4\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: b29e11ba8aad9044baf00bd88d907b4d, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC798 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC8FC\uAD50\uB2D8, \uC6D0\uACE0\uC5D0\uAC8C \uC9C8\uBB38\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 1
    nextDialogIndex: 21
    dialogType: 1
    choiceList:
    - startDialogIndex: 14
      choiceText: "\uC138 \uBC88\uC758 \uACC4\uC57D \uB0B4\uC6A9\uC744 \uC124\uBA85\uD574\uBCF4\uC2ED\uC2DC\uC624"
    - startDialogIndex: 17
      choiceText: "\uC544\uC9C1\uB3C4 \uC544\uBC84\uC9C0\uAC00 \uB2F9\uC2E0\uC744
        \uD1B5\uC81C\uD558\uACE0 \uC788\uC2B5\uB2C8\uAE4C?"
    - startDialogIndex: 19
      choiceText: "\uC99D\uAC70\uAC00 \uC788\uC2B5\uB2C8\uAE4C?"
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC138 \uBC88\uC758 \uACC4\uC57D \uB0B4\uC6A9\uC744 \uC124\uBA85\uD574\uBCF4\uC2ED\uC2DC\uC624"
    typingTime: 0.02
    speakerName: Player
    speakerJob: "\uD310\uC0AC"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uCCAB \uBC88\uC9F8\uB294 \uAC00\uC8FD\uC0C1\uC778\uC5D0\uAC8C, \uB450
      \uBC88\uC9F8\uB294 \uB18D\uC7A5\uC8FC\uC5D0\uAC8C, \uC138 \uBC88\uC9F8\uB294
      \uADC0\uC871\uC758 \uD558\uC778\uC73C\uB85C\uC694."
    typingTime: 0.02
    speakerName: "\uB8E8\uD0A4\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: e68e91281b6b12e448d264cc9646de06, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uBAA8\uB450 \uC81C \uC758\uC9C0\uC640 \uBB34\uAD00\uD558\uAC8C \uC774\uB8E8\uC5B4\uC9C4
      \uACC4\uC57D\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uD0A4\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 1
    nextDialogIndex: 12
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: ca228a10b6f0db6438bcc295e4b8ef8d, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC544\uC9C1\uB3C4 \uC544\uBC84\uC9C0\uAC00 \uB2F9\uC2E0\uC744 \uD1B5\uC81C\uD558\uACE0
      \uC788\uC2B5\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: Player
    speakerJob: "\uD310\uC0AC"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uB124, \uC9C0\uB09C\uC8FC\uC5D4 \uC81C \uC544\uB0B4\uC758 \uC678\uCD9C\uC744
      \uAE08\uC9C0\uD588\uACE0, \uC81C \uC218\uC785\uC758 \uC808\uBC18\uC744 \uAC15\uC81C\uB85C
      \uAC00\uC838\uAC14\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uD0A4\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 1
    nextDialogIndex: 12
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: b30a4b3b7a5c4e04c8ea290bc9b6be8f, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC99D\uAC70\uAC00 \uC788\uC2B5\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: Player
    speakerJob: "\uD310\uC0AC"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uB124, \uC138 \uACC4\uC57D \uBAA8\uB450 \uAE30\uB85D\uAD00 \uB9C8\uB974\uCF08\uB8E8\uC2A4\uC5D0\uAC8C\uC11C
      \uBC1B\uC740 \uC0AC\uBCF8\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uD0A4\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 1
    nextDialogIndex: 12
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: ec20428180dc07643942a672860ec3dd, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC774\uC81C \uD53C\uACE0, \uAC08\uB8E8\uC2A4\uB97C \uBD80\uB974\uACA0\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uD53C\uACE0, \uC9C4\uC220\uD558\uC2ED\uC2DC\uC624."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC73C\uC74C... \uC804 \uC800 \uC544\uC774\uB97C \uD314\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4!"
    typingTime: 0.02
    speakerName: "\uAC08\uB8E8\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: cce1fe7eb0818d5468a8d268dae20e4f, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uCCAB \uBC88\uC9F8, \uB450 \uBC88\uC9F8\uB294 \uB9DE\uC544\uC694.
      \uBA39\uACE0 \uC0B4\uAE30 \uC704\uD574 \uC5B4\uCA54 \uC218 \uC5C6\uC5C8\uC8E0."
    typingTime: 0.02
    speakerName: "\uAC08\uB8E8\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 56c51ad6cf0cb3f4e98abe90f69490c3, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uD558\uC9C0\uB9CC \uC138 \uBC88\uC9F8\uB294 \uADF8\uB0E5 \uC11C\uBA85\uC744
      \uB3C4\uC640\uC900 \uAC83\uBFD0\uC785\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uAC08\uB8E8\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: ec423c3729c549941a4485a725d5bec4, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC804 \uC2E4\uC81C\uB85C \uD310 \uC801 \uC5C6\uC2B5\uB2C8\uB2E4!"
    typingTime: 0.02
    speakerName: "\uAC08\uB8E8\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 7470748b169ad5f44adbe10a5fc84f9f, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uADF8\uB9AC\uACE0, \uC800 \uC544\uC774\uB294 \uC544\uC9C1 \uCCA0\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uAC08\uB8E8\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 7d27eb312f1415d4893cd3ceb6f0123b, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC790\uC2DD\uC774 \uC544\uBE44\uB97C \uBC95\uC815\uC5D0 \uC138\uC6B0\uB2E4\uB2C8\u2026
      \uC774\uB7F0 \uC2DC\uB300\uAC00 \uC62C \uC904\uC740 \uBAB0\uB790\uAD70\uC694."
    typingTime: 0.02
    speakerName: "\uAC08\uB8E8\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 3922acf4c5543534f96165c344bf390c, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC8FC\uAD50\uB2D8, \uD53C\uACE0\uC5D0\uAC8C \uC9C8\uBB38\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 1
    nextDialogIndex: 36
    dialogType: 1
    choiceList:
    - startDialogIndex: 30
      choiceText: "\uC138 \uBC88\uC9F8 \uACC4\uC57D\uC5D0 \uC11C\uBA85\uD558\uC168\uC2B5\uB2C8\uAE4C?"
    - startDialogIndex: 32
      choiceText: "\uACC4\uC57D\uC758 \uB300\uAC00\uB85C \uBB34\uC5C7\uC744 \uBC1B\uC558\uC2B5\uB2C8\uAE4C?"
    - startDialogIndex: 34
      choiceText: "\uBD80\uAD8C\uC744 \uD3EC\uAE30\uD560 \uC0DD\uAC01\uC740 \uC5C6\uC73C\uC2ED\uB2C8\uAE4C?"
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC138 \uBC88\uC9F8 \uACC4\uC57D\uC5D0 \uC11C\uBA85\uD558\uC168\uC2B5\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: Player
    speakerJob: "\uD310\uC0AC"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uD588\uC9C0\uB9CC, \uADF8\uAC74 \uB2E8\uC9C0 \uBCF4\uD638\uC790 \uC11C\uBA85\uC77C
      \uBFD0\uC774\uC5C8\uC2B5\uB2C8\uB2E4. \uB3C8\uB3C4 \uBC1B\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4!"
    typingTime: 0.02
    speakerName: "\uAC08\uB8E8\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 1
    nextDialogIndex: 29
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: cbaabc657d5fa6341ae3774171246458, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uACC4\uC57D\uC758 \uB300\uAC00\uB85C \uBB34\uC5C7\uC744 \uBC1B\uC558\uC2B5\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: Player
    speakerJob: "\uD310\uC0AC"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uD558, \uB300\uAC00\uB294 \uC5C6\uC5C8\uC18C. \uADF8 \uADC0\uC871
      \uAC00\uBB38\uACFC \uC798 \uC9C0\uB0B4\uACE0 \uC2F6\uC5C8\uC744 \uBFD0."
    typingTime: 0.02
    speakerName: "\uAC08\uB8E8\uC2A4"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 1
    nextDialogIndex: 29
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: ed086f736054496469646e912dd81e85, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uBD80\uAD8C\uC744 \uD3EC\uAE30\uD560 \uC0DD\uAC01\uC740 \uC5C6\uC73C\uC2ED\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: Player
    speakerJob: "\uD310\uC0AC"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC544\uB2C8\uC624. \uC800 \uC544\uC774\uB294 \uC18C\uC911\uD55C \uC81C
      \uC544\uB4E4\uC785\uB2C8\uB2E4."
