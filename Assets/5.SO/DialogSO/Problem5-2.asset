    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uB9AC\uC544\uB294 \uC5EC\uC804\uD788 \uC5D0\uC6B0\uD398\uBBF8\uC544
      \uAC00\uBB38\uC758 \uC815\uD1B5 \uC0C1\uC18D\uC778\uC774\uBA70,"
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: f0da67942c684344bb790da89428aa36, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uD63C\uC778\uACFC \uADC0\uC18D\uC740 \uBC95\uC801 \uC815\uCCB4\uC131\uC744
      \uBCC0\uACBD\uD560 \uC218 \uC5C6\uB2E4."
