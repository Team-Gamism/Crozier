    dialogSound: {fileID: 8300000, guid: 4e59036d230d373468ee8121e4ba20c6, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "(\uBD88\uB9CC) \uD63C\uC778\uC758 \uC2E0\uC131\uD568\uC744 \uBD80\uC815\uD558\uB294\uAC74
      \uBC95\uC758 \uD30C\uAD34\uC785\uB2C8\uB2E4!"
