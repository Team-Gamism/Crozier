  m_Name: Problem5
  m_EditorClassIdentifier: 
  dialogDataList:
  - textData: "\uC7AC\uD310\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 3b9a8c4de01b3fa4d8b6e51c8e1de5d6, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC774\uBC88 \uC0AC\uAC74\uC740 \uADC0\uC871 \uC5EC\uC778 \uB9AC\uC544\uAC00
      \uD63C\uC778\uD55C \uD6C4 \uADF8 \uADC0\uC18D \uAC00\uBB38\uC774 \uC5B4\uB514\uC778\uAC00\uC5D0
      \uB300\uD55C \uBC95\uC801 \uBD84\uC7C1\uC785\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 9ade7a185731eab46ad86ebcb55e79ad, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uB0A8\uD3B8\uC778 \uBC14\uB974\uD1A8\uB85C\uBA54\uC624 \uACBD\uC758
      \uAC00\uBB38\uC740 \uD63C\uC778\uACFC \uC9C0\uCC38\uAE08\uC744 \uADFC\uAC70\uB85C
      '\uADC0\uC18D \uC644\uB8CC'\uB97C \uC8FC\uC7A5\uD558\uACE0 \uC788\uC73C\uBA70,"
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 8f1dc87844eba324cb965fc1b3911ee0, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uB9AC\uC544\uC758 \uCE5C\uAC00\uC778 \uC5D0\uC6B0\uD398\uBBF8\uC544
      \uAC00\uBB38\uC740 '\uC0C1\uC18D\uACFC \uC758\uBB34\uB294 \uC5EC\uC804\uD788
      \uBCF8\uAC00\uC5D0 \uC788\uB2E4'\uBA70 \uC774\uC758\uB97C \uC81C\uAE30\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 7ab275f20d7a51d4ba2eb83a35ec52f0, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uBA3C\uC800 \uD53C\uACE0 \uB9AC\uC544\uC758 \uB0A8\uD3B8 \uAC00\uBB38\uB300\uD45C
      \uBC1C\uC5B8\uC744 \uC694\uCCAD\uD569\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: e0a8bf5ab474a9a49b2bbfb0901cb48a, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC8FC\uAD50\uB2D8, \uB9AC\uC544\uB294 \uD63C\uC778 \uC11C\uC57D\uC744
      \uD1B5\uD574 \uC9C0\uCC38\uAE08\uC744 \uC218\uB839\uD558\uC600\uACE0,"
    typingTime: 0.02
    speakerName: "\uBC14\uB974\uD1A8\uB85C\uBA54\uC624"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 4ca8764acedc09c42b72c34c8572d39e, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC800\uD76C \uAC00\uBB38\uC5D0 \uC785\uC801\uB418\uC5B4 3\uB144\uAC04
      \uB3D9\uC77C \uBB38\uC7A5\uACFC \uBA85\uD328 \uC544\uB798 \uC0DD\uD65C\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uBC14\uB974\uD1A8\uB85C\uBA54\uC624"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 3215ab7557187ca4391fbc5faa57e27e, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uB610\uD55C, \uC544\uB4E4\uAE4C\uC9C0 \uCD9C\uC0B0\uD55C \uC0C1\uD0DC\uC5D0\uC11C
      \uCE5C\uAC00\uC5D0 \uC18C\uC18D\uB41C\uB2E4\uACE0 \uC8FC\uC7A5\uD558\uB294
      \uAC83\uC740"
    typingTime: 0.02
    speakerName: "\uBC14\uB974\uD1A8\uB85C\uBA54\uC624"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 88ab0f00476aa1543820c37a1f130361, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uBAA8\uB4E0 \uADC0\uC871 \uAD00\uC2B5\uACFC \uC2E0\uC758 \uC9C8\uC11C\uB97C
      \uC704\uBC18\uD558\uB294 \uAC83\uC785\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uBC14\uB974\uD1A8\uB85C\uBA54\uC624"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 24f3ef9fd40637b45a57a112b56d8347, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uADF8\uB140\uB294 \uC774\uC81C \uC6B0\uB9AC \uC9D1\uC758 \uC774\uB984\uC744
      \uAC16\uACE0, \uC6B0\uB9AC \uC2E0\uD0C1\uC5D0 \uB530\uB77C \uC6C0\uC9C1\uC785\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uBC14\uB974\uD1A8\uB85C\uBA54\uC624"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 317e76451b8a0c340b1c2b73b705a530, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uBC95\uB3C4 \uADF8\uB807\uACE0, \uBA85\uC608\uB3C4 \uADF8\uB807\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uBC14\uB974\uD1A8\uB85C\uBA54\uC624"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 514a001ed1b16ca49b3ed3a9cd15ec61, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uAC10\uC0AC\uD569\uB2C8\uB2E4.\uB2E4\uC74C\uC73C\uB85C \uC6D0\uACE0
      \uB9AC\uC544\uC758 \uCE5C\uAC00 \uB300\uD45C \uBC1C\uC5B8\uC744 \uCCAD\uD569\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 58d55594d0a2a744fb0364098cd04ff3, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC8FC\uAD50\uB2D8, \uC6B0\uB9AC \uAC00\uBB38\uC740 \uB9AC\uC544\uB97C
      \uB2E8\uC21C\uD55C \uACB0\uD63C\uC218\uB2E8\uC73C\uB85C \uC0DD\uAC01\uD558\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uC728\uB9AC\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 89568e36c6794dd4e84e34f950db719a, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uADF8\uB140\uB294 \uC544\uBC84\uC9C0\uC758 \uB9C8\uC9C0\uB9C9 \uC720\uC5B8\uC7A5\uC744
      \uD1B5\uD574 \uC7AC\uC0B0 \uC77C\uBD80\uC758 \uACF5\uB3D9 \uC0C1\uC18D\uC778\uC73C\uB85C
      \uBA85\uC2DC\uB418\uC5B4 \uC788\uC73C\uBA70,"
    typingTime: 0.02
    speakerName: "\uC728\uB9AC\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 931caa47d521c8645a465c19e94dd002, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uD63C\uC778 \uC2DC\uC5D0\uB3C4 \uAC00\uBB38 \uBB38\uC7A5\uC758 \uC0AC\uC6A9\uAD8C\uC740
      \uBC15\uD0C8\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uC728\uB9AC\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: e1409d0c39d5bfe49ad6d5e2cdf80a46, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uAC8C\uB2E4\uAC00, \uC9C0\uCC38\uAE08\uC740 \uC2E0\uB791 \uCE21\uC758
      \uC694\uAD6C\uB85C \uC8FC\uC5B4\uC9C4 \uBCF4\uC99D\uAE08 \uD615\uD0DC\uC774\uBA70,"
    typingTime: 0.02
    speakerName: "\uC728\uB9AC\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 6d420921c58d8e44093994584395e3cb, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC18C\uC720\uAD8C \uC774\uC804\uC774 \uC544\uB2CC \uD63C\uC778 \uBCF4\uC99D
      \uAE30\uAE08\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uC728\uB9AC\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 788c264a60f55ea49bfc5b6d50649ac6, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uB9AC\uC544\uB294 \uD615\uC2DD\uC0C1 \uB0A8\uD3B8 \uC9D1\uC5D0 \uAC70\uC8FC\uD558\uC9C0\uB9CC,"
    typingTime: 0.02
    speakerName: "\uC728\uB9AC\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 9a32e78a5fb690842b112d78cab80e81, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uBC95\uC801\uC73C\uB85C\uB294 \uBCF8\uAC00 \uC18C\uC18D\uC758 \uADC0\uC871
      \uC5EC\uC131\uC73C\uB85C \uC720\uC9C0\uB418\uC5B4\uC57C \uD569\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uC728\uB9AC\uC6B0\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 90a80d68aeb88e547bef9f4b2ad48a04, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uB9AC\uC544 \uBCF8\uC778\uB3C4 \uC624\uB298 \uC774 \uC790\uB9AC\uC5D0
      \uB098\uC640 \uC788\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: b1f571469c92e6046b80672d1e8a6d0e, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uBCF8\uC778\uC758 \uC758\uC0AC\uB97C \uBC1D\uD788\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 5d83bf28bead39e44810292de995c94b, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC800\uB294... \uC81C \uC544\uBC84\uC9C0\uC758 \uC720\uC5B8\uC744
      \uB530\uB974\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB9AC\uC544"
    speakerJob: '-'
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 1cb3dc4ba833a574f86b967083125f3f, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC9C0\uAE08\uC740 \uB0A8\uD3B8\uC758 \uC9D1\uC5D0\uC11C \uC0B4\uACE0
      \uC788\uC9C0\uB9CC, \uC81C \uB9C8\uC74C\uACFC \uC758\uBB34\uB294 \uC5EC\uC804\uD788
      \uC5D0\uC6B0\uD398\uBBF8\uC544 \uAC00\uBB38\uC5D0 \uC788\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB9AC\uC544"
    speakerJob: 
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 0566940dd03630f4d933f124de1019c8, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uB450 \uAC00\uBB38 \uBAA8\uB450 \uC800\uB97C \uC704\uD574 \uC2F8\uC6B4\uB2E4
      \uD558\uC9C0\uB9CC..."
    typingTime: 0.02
    speakerName: "\uB9AC\uC544"
    speakerJob: 
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 3cbdfbf91ef1399448e975bbbbe05c47, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC800\uB294 \uB3C4\uAD6C\uAC00 \uC544\uB2C8\uB77C \uD55C \uC0AC\uB78C\uC758
      \uB538\uB85C \uAE30\uC5B5\uB418\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB9AC\uC544"
    speakerJob: 
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: a05f7fd111dc7cd4ab7db84d01d84454, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC8FC\uAD50\uB2D8, \uC9C8\uBB38 \uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 1
    nextDialogIndex: 34
    dialogType: 1
    choiceList:
    - startDialogIndex: 26
      choiceText: "\uD63C\uC778 \uACC4\uC57D\uC11C\uC5D0 \uADC0\uC18D\uC870\uD56D\uC774
        \uBA85\uC2DC\uB418\uC5C8\uC2B5\uB2C8\uAE4C?"
    - startDialogIndex: 28
      choiceText: "\uC9C0\uCC38\uAE08\uC740 \uBC18\uD658 \uBD88\uAC00\uD569\uB2C8\uAE4C?"
    - startDialogIndex: 30
      choiceText: "\uC544\uBC84\uC9C0\uC758 \uC720\uC5B8\uC7A5\uC740 \uACF5\uC99D\uB418\uC5C8\uC2B5\uB2C8\uAE4C?"
    - startDialogIndex: 32
      choiceText: "\uB9AC\uC544\uB294 \uCE5C\uAC00 \uC0C1\uC18D\uC744 \uC2E4\uC81C\uB85C
        \uBC1B\uC558\uC2B5\uB2C8\uAE4C?"
    dialogSound: {fileID: 8300000, guid: 6e05a07b33ba8a9488c01d97b98aeb56, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uD63C\uC778 \uACC4\uC57D\uC11C\uC5D0 \uADC0\uC18D\uC870\uD56D\uC774
      \uBA85\uC2DC\uB418\uC5C8\uC2B5\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: Player
    speakerJob: "\uD310\uC0AC"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uBA85\uC2DC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \u2018\uD63C\uC778\uACFC
      \uB3D9\uC2DC\uC5D0 \uBC14\uB974\uD1A8\uB85C\uBA54\uC624 \uAC00\uBB38\uC758
      \uC77C\uC6D0\uC774 \uB41C\uB2E4'\uB77C\uAD6C\uC694."
    typingTime: 0.02
    speakerName: "\uBC14\uB974\uD1A8\uB85C\uBA54\uC624"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 1
    nextDialogIndex: 25
