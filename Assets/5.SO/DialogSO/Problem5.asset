    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC9C0\uCC38\uAE08\uC740 \uBC18\uD658 \uBD88\uAC00\uD569\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: Player
    speakerJob: "\uD310\uC0AC"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC608. \u2018\uACB0\uD63C \uBD88\uD654 \uC2DC\uC5D0\uB3C4 \uBC18\uD658\uD558\uC9C0
      \uC54A\uB294\uB2E4\u2019\uB294 \uC870\uD56D\uC774 \uD3EC\uD568\uB418\uC5B4
      \uC788\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
