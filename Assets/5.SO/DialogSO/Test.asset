    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 1
    nextDialogIndex: 29
    dialogType: 1
    choiceList:
    - startDialogIndex: 22
      choiceText: "\uAD6C\uAC78\uD560 \uC0DD\uAC01\uC740 \uC65C \uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uAE4C?"
    - startDialogIndex: 24
