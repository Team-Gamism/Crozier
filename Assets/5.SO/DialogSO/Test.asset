  dialogDataList:
  - textData: "\uC7AC\uD310\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4! \uBAA8\uB450
      \uC815\uC219\uD574\uC8FC\uC2ED\uC2DC\uC624!"
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 9cc4bd6e249865e42aa7d5f2ba8e85ea, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC6D0\uACE0 \uC5D0\uB108\uC2A4, \uC9C4\uC220\uD558\uC2ED\uC2DC\uC624."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 2845a7c559cd0c84991e3aaf17b6c655, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC8FC\uAD50\uB2D8! \uC800\uC790\uAC00 \uC81C \uAC00\uAC8C\uC5D0\uC11C
      \uBE75\uC744 \uD6D4\uCCE4\uC2B5\uB2C8\uB2E4!"
    typingTime: 0.02
    speakerName: "\uC5D0\uB108\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: e6728ad580820cb4294e7d51246305e1, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC81C \uB208\uC73C\uB85C \uB611\uB611\uD788 \uBCF4\uC558\uB2E4\uAD6C\uC694!"
    typingTime: 0.02
    speakerName: "\uC5D0\uB108\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: e9a64b699945f574988ded73375ffbaa, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC9C4\uC220\uC5D0 \uB300\uD574 \uC5EC\uCB59\uACE0 \uC2F6\uC740 \uC810
      \uC788\uC73C\uC2ED\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 1
    nextDialogIndex: 12
    dialogType: 1
    choiceList:
    - startDialogIndex: 5
      choiceText: "\uD6D4\uCE5C \uBE75\uC740 \uC5BC\uB9C8\uC600\uC2B5\uB2C8\uAE4C?"
    - startDialogIndex: 7
      choiceText: "\uBE75\uC744 \uD6D4\uCE5C\uAC74 \uC5B8\uC81C\uC785\uB2C8\uAE4C?"
    - startDialogIndex: 10
      choiceText: "\uADF8 \uBE75\uC740 \uB9DB\uC788\uB294 \uBE75\uC774\uC5C8\uC2B5\uB2C8\uAE4C?"
    dialogSound: {fileID: 8300000, guid: eac48b451b6e115489e87bc04cbe18d6, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uD6D4\uCE5C \uBE75\uC740 \uC5BC\uB9C8\uC600\uC2B5\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: Player
    speakerJob: "\uD310\uC0AC"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC74C.. \uADF8 \uBE75\uC740 \uB300\uB7B5 1.5 \uB370\uB098\uB85C\uC815\uB3C4
      \uD558\uB294 \uBE75\uC774\uC5C8\uC2B5\uB2C8\uB2E4!"
    typingTime: 0.02
    speakerName: "\uC5D0\uB108\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 1
    nextDialogIndex: 4
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: aaa125233c4fa4843aeaca53fa3c10aa, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uBE75\uC744 \uD6D4\uCE5C\uAC74 \uC5B8\uC81C\uC785\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: Player
    speakerJob: "\uD310\uC0AC"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uBC14\uB85C \uC5B4\uC81C \uC810\uC2EC\uBB34\uB835\uC785\uB2C8\uB2E4!"
    typingTime: 0.02
    speakerName: "\uC5D0\uB108\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 5885e7d4c575fef4988e73cfa8ea076b, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC81C\uAC00 \uC7A0\uC2DC \uC790\uB9AC\uB97C \uBE44\uC6B4 \uC0AC\uC774
      \uC800\uC790\uAC00 \uBE75\uC744 \uD6D4\uCCD0\uC11C \uB3C4\uB9DD\uCCE4\uC5B4\uC694!"
    typingTime: 0.02
    speakerName: "\uC5D0\uB108\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 1
    nextDialogIndex: 4
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 61509145daf41724c85be9a0458725d5, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uADF8 \uBE75\uC740 \uB9DB\uC788\uB294 \uBE75\uC774\uC5C8\uC2B5\uB2C8\uAE4C?"
    typingTime: 0.02
    speakerName: Player
    speakerJob: "\uD310\uC0AC"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 0}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "..\uC608? \uC608 \uBB50.. \uB9DB\uC788\uB294 \uBE75\uC774\uC5C8\uC2B5\uB2C8\uB2E4..
      \uADF8\uB7F0\uB370 \uADF8\uAC74 \uC65C..?"
    typingTime: 0.02
    speakerName: "\uC5D0\uB108\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 1
    nextDialogIndex: 4
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 7486be58bbd41e24d80a7c6f21605a8e, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "(\uC18D\uC0AD\uC774\uBA70) \uC9C8\uBB38 \uC5C6\uC73C\uC2DC\uB2E4\uBA74,
      \uD53C\uACE0 \uC9C4\uC220\uB85C \uB118\uC5B4\uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: ab686e90301a41e4fafadf3df38702f1, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC798 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. \uD53C\uACE0 \uBE4C \uC7A5,
      \uC9C4\uC220\uD558\uC2ED\uC2DC\uC624."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 83af61881251ce24a91b81f72c6c4618, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC8FC\uAD50\uB2D8.. \uC800\uB294 \uC8C4\uC778\uC785\uB2C8\uB2E4...."
    typingTime: 0.02
    speakerName: "\uBE4C"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 338950d24459025458f4d1967d801661, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC800\uB294 \uADF8\uB0A0 \uC815\uB9D0 \uAD76\uC8FC\uB9BC\uC5D0 \uC9C0\uCCD0
      \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uBE4C"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 5d1f36b7ca3148a45a1207793184c593, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC774\uD2C0\uB3D9\uC548 \uC544\uBB34\uAC83\uB3C4 \uBA39\uC9C0 \uBABB\uD55C
      \uCC44 \uAC70\uB9AC\uB97C \uB5A0\uB3CC\uC558\uACE0"
    typingTime: 0.02
    speakerName: "\uBE4C"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: a24926e95bdc74c4dbafb72b565fc069, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uAC00\uC9C4\uAC70\uB77C\uACE0\uB294 \uC774 \uB2E4 \uD5E4\uC9C4 \uC637
      \uD55C \uBC8C\uBFD0\uC774\uC5C8\uC2B5\uB2C8\uB2E4.."
    typingTime: 0.02
    speakerName: "\uBE4C"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 989c6488d425e3b428b346199eda4dce, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uBE75\uC9D1 \uC55E\uC744 \uC9C0\uB098\uB358 \uC21C\uAC04, \uC9C4\uC5F4\uB300\uC5D0
      \uC788\uB358 \uBE75 \uB0C4\uC0C8\uAC00 \uC800\uB97C \uBBF8\uCE58\uAC8C \uB9CC\uB4E4\uC5C8\uACE0,
      \uC81C \uC190\uC774 \uBA4B\uB300\uB85C \uC6C0\uC9C1\uC600\uC2B5\uB2C8\uB2E4.."
    typingTime: 0.02
    speakerName: "\uBE4C"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: a65212006b1c33a4193f006a9fa7825e, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\uC8FC\uAD50\uB2D8, \uC800\uB294 \uB3C4\uB451\uC774 \uB418\uACE0 \uC2F6\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4.. \uADF8\uC800.. \uC0B4\uACE0 \uC2F6\uC5C8\uC744
      \uBFD0\uC774\uC5C8\uC2B5\uB2C8\uB2E4..."
    typingTime: 0.02
    speakerName: "\uBE4C"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 6efa6a86c1d55cb4ebff2a753394ac63, type: 3}
    isLastDialog: 0
    isNoRecord: 0
  - textData: "\u2026\u2026(\uC870\uC6A9\uD788) \uCC38 \uC548\uB410\uAD70\uC694."
