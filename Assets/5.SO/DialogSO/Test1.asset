  dialogDataList:
  - textData: "\uC8FC\uAD50\uB2D8\uC758 \uD310\uACB0\uC744 \uC804\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 2dcbf3b6082e9e5438c19528196845c9, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uD53C\uACE0 \uBE4C \uC7A5\uC740 \uBD84\uBA85 \uBC94\uBC95\uC744 \uC800\uC9C8\uB800\uC73C\uB098,
      \uC808\uBC15\uD55C \uC0AC\uC815\uB3C4 \uD568\uAED8 \uC874\uC7AC\uD558\uC600\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: ba1cf609dca4be44784bc0937ed91194, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uADF8\uB7EC\uB098 \uBC95\uC740 \uBC95\uC785\uB2C8\uB2E4. \uD6D4\uCE5C
      \uBE75 \uAC12 1.5\uB370\uB098\uB85C\uC758 \uB450 \uBC30\uC778 3\uB370\uB098\uB85C\uB97C
      \uC6D0\uACE0\uC5D0\uAC8C \uBC30\uC0C1\uD558\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: a1b5acd07bea41344925b372f6378c36, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uC774 \uC815\uB3C4\uBA74... \uB0A9\uB4DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uC5D0\uB108\uC2A4"
    speakerJob: "\uC6D0\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 02a13a99aa6bd544d8024d1d73545adc, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uB124... \uB2F9\uC5F0\uD55C \uCC98\uBD84\uC774\uB77C \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    typingTime: 0.04
    speakerName: "\uBE4C"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 1c38c16d51023b242b3c51dc38839404, type: 3}
    isLastDialog: 1
    isNoRecord: 1
  - textData: "\uADF8\uB0A0\uC758 \uBC30\uACE0\uD514\uC744... \uB2E4\uC2DC\uB294
      \uBC18\uBCF5\uD558\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uBE4C"
    speakerJob: "\uD53C\uACE0"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: 2b2578d42c2b77d4dbe864f2bcfa6039, type: 3}
    isLastDialog: 1
    isNoRecord: 1
  - textData: "\uC790\uBE44\uC640 \uC815\uC758 \uC0AC\uC774, \uC624\uB298\uC740 \uADF8
      \uACBD\uACC4\uC5D0 \uC130\uC2B5\uB2C8\uB2E4."
    typingTime: 0.02
    speakerName: "\uB8E8\uCE74"
    speakerJob: "\uC11C\uAE30"
    nextDialogMethod: 0
    nextDialogIndex: 0
    dialogType: 0
    choiceList: []
    dialogSound: {fileID: 8300000, guid: e3af1ef2980df4842bdc8137b7668352, type: 3}
    isLastDialog: 0
    isNoRecord: 1
  - textData: "\uC8FC\uAD50\uB2D8\uC774\uB77C\uBA74 \uB2E4\uB978 \uC7AC\uD310\uB4E4\uB3C4
